# Modelo ATIVO — o que o agente e os scripts dos exercícios usam (docs/modelos.md §3.4).
# A mesma chave da Groq abaixo serve aqui.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=

# Juiz LLM dos Exercícios 7 e 11. Vazio = usa o LLM_MODEL. Recomendado: um modelo DIFERENTE do
# gerador no mesmo provedor (reduz auto-preferência; no tier gratuito o limite é por modelo).
JUDGE_MODEL=

# Embeddings do RAG e da memória (src/rag/embeddings.py). "local" roda na CPU sem chave
# (multilingual-e5-large, ~2,2 GB no primeiro uso); "mistral" usa mistral-embed (exige chave).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-large
MISTRAL_API_KEY=

# Os três candidatos avaliados em docs/modelos.md (item 3) — usados por scripts/compare_models.py
# para rodar os mesmos 5 casos de domínio nos três e comparar de verdade, não por leaderboard.
# Nomes de modelo conferidos ao vivo em 2026-09-20 (client.models.list() de cada provedor) —
# o catálogo de modelos gratuitos muda com frequência; confira o que está disponível antes de usar.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Banco de preços real (fractal-precos, SQL Server). Vazio = o agente usa automaticamente
# o espelho local em SQLite (dados/precos_mock.db, gerado por scripts/seed_mock_db.py).
FRACTALPRECOS_CONNECTION_STRING=

# Orçamento do laço do agente (src/grafo/dependencias.py::Tetos; o agente da Parte 1 usa os dois primeiros)
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=20000
# Teto de tempo de parede por turno, em segundos
AGENT_MAX_SECONDS=90
# Prazo da aprovação humana (exportar_analise); vencido, a execução expira sem exportar (docs/humano.md §4)
AGENT_PRAZO_APROVACAO_HORAS=24
# 1 = memória de longo prazo ligada (dados/memoria/); 0 = desligada
AGENT_MEMORIA=1
